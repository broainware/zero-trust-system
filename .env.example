# SERVER CONFIGURATION
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

GATEWAY_URL=http://localhost:3000
# DATABASE
DATABASE_PATH=./database/zero-trust.sqlite

# JWT CONFIGURATION
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_SERVICE_SECRET=change_this_service_secret

# TOKEN EXPIRATION
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=1d
SERVICE_TOKEN_EXPIRES_IN=5m

# GATEWAY SECURITY
GATEWAY_SECRET=change_this_gateway_secret

# SERVICE AUTHENTICATION
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=change_this_client_secret

# ACCESS TIME
ACCESS_WINDOW_START=07:00
ACCESS_WINDOW_END=21:00
TIMEZONE=Asia/Jakarta