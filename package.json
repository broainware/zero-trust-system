{
  "name": "zero-trust-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Nilai dengan penerapan Zero Trust Security",
  "main": "gateway/server.js",
  "scripts": {
    "dev": "concurrently -k -n GATEWAY,NILAI,TRANSKRIP \"npm:dev:gateway\" \"npm:dev:nilai\" \"npm:dev:transkrip\"",
    "dev:gateway": "nodemon gateway/server.js",
    "dev:nilai": "nodemon service-nilai/server.js",
    "dev:transkrip": "nodemon service-transkrip/server.js",
    "init-db": "node scripts/init-db.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}